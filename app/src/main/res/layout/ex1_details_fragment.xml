<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ex1_details_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Это фрагмент Details"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ex1_details_count_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:text="Счётчик +1" />

        <TextView
            android:id="@+id/ex1_counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="0"
            android:textSize="32sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ex1_details_to_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="К Settings" />

        <Button
            android:id="@+id/ex1_details_to_home_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Домой" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>